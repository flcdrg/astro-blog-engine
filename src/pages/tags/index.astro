---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCurrentPosts, groupPostsByTag } from "../../scripts/posts";
import { getCanonicalUrl } from "../../scripts/canonical";
const pageTitle = "Blog Tags Archive";
const allPosts = getCurrentPosts(await getCollection("blog"));

// Collate all tags from all posts and count posts per tag
const tagCounts = [...groupPostsByTag(allPosts)].map(([tag, posts]) => [
  tag,
  posts.length,
] as const);

const tags = tagCounts.sort(([tagA], [tagB]) =>
  tagA.localeCompare(tagB)
);

const description = "Browse all Dave's Daydreams blog tags to find posts grouped by topic, with counts for each tag and links to tagged archives.";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Blog Tags",
  description: description,
  url: getCanonicalUrl(Astro.url, Astro.site),
};

const frontmatter = {
  description,
};
---

<BaseLayout pageTitle={pageTitle} frontmatter={frontmatter} pageJsonLd={collectionJsonLd} noindex={true}>
  <h1>Tags</h1>

  <p>Find posts categorised by tags:</p>
  <div class="tags">
    {
      tags.map(([tag, count]) => (
        <p class="tag">
          <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a> ({count})
        </p>
      ))
    }
  </div>
</BaseLayout>

<style>
  a {
    color: #00539f;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #f8fcfd;
  }

  :global(.dark) .tag {
    background-color: #1a1a1a;
    border-color: #5a5959;
    color: #f0f0f0;
  }

  :global(.dark) a {
    color: #6eb5ff;
  }
</style>
