---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import CustomImage from "../components/CustomImage.astro";
import DateTimeComponent from "../components/DateTimeComponent.astro";
import onlyCurrent from "../scripts/filters";

const pageTitle = "Dave's Daydreams - David Gardiner's Blog";

const allPosts = (await getCollection("blog"))
  .filter(onlyCurrent)
  .sort(
    (a: any, b: any) =>
      new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

const totalPostCount = allPosts.length;
const latestFullPosts = allPosts.slice(0, 2);
const moreRecentPosts = allPosts.slice(2, 10);
const displayedPosts = [...latestFullPosts, ...moreRecentPosts];
const recentArchiveYears = [
  ...new Set(allPosts.map((post) => post.id.split("/")[0]).filter(Boolean)),
].slice(0, 3);
const latestFullPostEntries = await Promise.all(
  latestFullPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  }),
);

const baseUrl = Astro.site ?? Astro.url;
const homepageUrl = new URL("/", baseUrl).toString();

const description = "Dave's Daydreams is David Gardiner's blog about .NET, Azure, DevOps, software engineering, practical experiments, and personal reflections.";

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${homepageUrl}#collection`,
      url: homepageUrl,
      name: pageTitle,
      description:
        description,
      isPartOf: {
        "@id": `${new URL("/", baseUrl).toString()}#website`,
      },
      mainEntity: {
        "@id": `${homepageUrl}#recent-posts`,
      },
    },
    {
      "@type": "ItemList",
      "@id": `${homepageUrl}#recent-posts`,
      name: "Recent posts",
      description: "The latest two posts are shown in full, with additional recent posts listed below.",
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      numberOfItems: displayedPosts.length,
      itemListElement: displayedPosts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "BlogPosting",
          "@id": new URL(post.id, baseUrl).toString(),
          url: new URL(post.id, baseUrl).toString(),
          headline: post.data.title,
          description: post.data.description?.replace(/\s+/g, " ").trim() || undefined,
          datePublished: post.data.date,
        },
      })),
    },
  ],
};

const frontmatter = {
  description:
    description,
};

---

<BaseLayout pageTitle={pageTitle} frontmatter={frontmatter} pageJsonLd={homeJsonLd} canonicalUrl={homepageUrl}>
  <link rel="sitemap" href="/sitemap-index.xml" slot="head" />

  <div slot="site-title">
    <h1>Dave's Daydreams</h1>
    <p>
      David Gardiner's blog of software development, .NET and other interesting
      things
    </p>
  </div>

  {
    latestFullPostEntries.map(({ post, Content }) => (
      <section>
        <h2>
          <BlogPost url={`/${post.id}`} title={post.data.title} />
        </h2>
        <p>
          <DateTimeComponent date={post.data.date} />{" "}
        </p>
        {post.data.image && !post.data.hideImageOnHome && (
          <CustomImage
            desktopImgUrl={post.data.image!}
            alt={post.data.imageAlt}
          />
        )}
        <article data-full-post-content>
          <Content />
        </article>
        <div style="clear: both" />
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <p class="tag">
              <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
            </p>
          ))}
        </div>
      </section>
    ))
  }

  {moreRecentPosts.length > 0 && (
    <>
      <h2>More recent posts</h2>
      <ul>
        {moreRecentPosts.map((post) => (
          <li>
            <a href={`/${encodeURI(post.id)}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Older posts</h2>
  <p>
    All posts (currently {totalPostCount}) can be found in the <a href="/archive">archive</a>. {recentArchiveYears.length > 0 && (
      <>
        {" "}Jump to recent years in{" "}
        {recentArchiveYears.map((year, index) => (
          <>
            <a href={`/${year}`}>{year}</a>
            {index < recentArchiveYears.length - 2
              ? ", "
              : index === recentArchiveYears.length - 2
                ? " and "
                : ""}
          </>
        ))}
        .
      </>
    )}
  </p>
</BaseLayout>

<style>
  .list-none {
    list-style-type: none;
  }
</style>
