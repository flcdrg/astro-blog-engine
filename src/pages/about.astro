---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePicture from '../assets/david-gardiner-1x1.jpg';
import { authorJobTitle, authorName, authorSameAs, getAuthorId } from '../scripts/author';

const pageTitle = "About David Gardiner";

const frontmatter = {
  description:
    "Profile of David Gardiner, an Adelaide-based senior developer at SixPivot, Microsoft MVP, community organiser, and writer on .NET, Azure, and DevOps.",
};

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "dateCreated": "2025-01-01T12:34:00+10:30",
    "dateModified": "2025-08-09T21:34:00+09:30",
    "mainEntity": {
        "@type": "Person",
        "@id": getAuthorId(Astro.site),
        "name": authorName,
        "alternateName": "flcdrg",
        "image": new URL(profilePicture.src, Astro.site).toString(),
        "url": new URL("/about", Astro.site).toString(),
        "jobTitle": authorJobTitle,
        "worksFor": {
            "@type": "Organization",
            "name": "SixPivot",
            "url": "https://sixpivot.com.au/"
        },
        "knowsAbout": ["Software Development", "Azure", ".NET", "DevOps", "Open Source"],
        "sameAs": authorSameAs
    }
};
---

<BaseLayout pageTitle={pageTitle} frontmatter={frontmatter} pageJsonLd={jsonLd}>
<Image src={profilePicture} alt="Photo of David Gardiner" width="300" height="300" loading="eager" class="profile" />
<h1>About David</h1>

<p>David Gardiner has been creating software for over 25 years. He has a passion for continual learning and improving quality, and enjoys being in and creating environments where these happen. A Microsoft MVP (Development Technologies), he helps run the <a href="https://www.meetup.com/Adelaide-dotNET/">Adelaide .NET User Group</a>, 
    and is one of the organisers of <a href="https://dddadelaide.com">DDD Adelaide</a>.</p>

<p>Based in Adelaide, South Australia, he works as a Senior Developer at <a href="https://sixpivot.com.au/">SixPivot</a>. In his spare time, he contributes to numerous open source projects (including some of his own) and is a package moderator at <a href="https://Chocolatey.org">Chocolatey.org</a>.</p>

<div style="clear: both;"></div>
</BaseLayout>
<style>
  .profile {
    /* align image left */
    float: left;
    margin-right: 1rem;
  }
</style>