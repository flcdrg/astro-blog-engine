---
import DateTimeComponent from "../components/DateTimeComponent.astro";
import { getCanonicalUrl } from "../scripts/canonical";
import { indexWordThreshold, isBelowIndexWordThreshold, isPostFrom2025Onwards, isPostNoindex } from "../scripts/indexing";
import BaseLayout from "./BaseLayout.astro";
import { Disqus } from "astro-disqus";

type PostLink = { id: string; title: string };

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: undefined | string;
    tags: string[];
    imageAlt?: string | undefined;
    modified_time?: string | undefined;
    index?: boolean | undefined;
    image?: {
      src: string;
      width: number;
      height: number;
    } | undefined;
  };
  wordCount?: number | undefined;
  previous?: PostLink | undefined;
  next?: PostLink | undefined;
  related?: PostLink[] | undefined;
}
const { frontmatter, wordCount, previous, next, related } = Astro.props;

const description = frontmatter.description;
const image = frontmatter.image;
const title = frontmatter.title;

const canonicalUrl = getCanonicalUrl(Astro.url, Astro.site);
const canonicalUrlString = canonicalUrl?.toString();
const shouldRenderDisqus =
  process.env.GITHUB_REF === "refs/heads/main" &&
  process.env.GITHUB_REPOSITORY !== "flcdrg/astro-blog-engine";

const getAbsoluteUrl = (path: string) => new URL(path, Astro.site ?? Astro.url).toString();

const postPathSegments = Astro.url.pathname.replace(/^\/|\/$/g, "").split("/");
const yearSegment = postPathSegments[0];
const hasYearSegment = /^\d{4}$/.test(yearSegment ?? "");

const archiveBreadcrumbs = hasYearSegment
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Archive",
          item: getAbsoluteUrl("/archive"),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: yearSegment,
          item: getAbsoluteUrl(`/${yearSegment}`),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: title,
          item: canonicalUrlString,
        },
      ],
    }
  : null;

const tagBreadcrumbs = (frontmatter.tags ?? []).map((tag) => ({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tags",
      item: getAbsoluteUrl("/tags"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: tag,
      item: getAbsoluteUrl(`/tags/${encodeURIComponent(tag)}`),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: canonicalUrlString,
    },
  ],
}));

// https://www.cemkiray.com/posts/how-to-add-json-ld-schema-in-astro/
// https://developers.google.com/search/docs/appearance/structured-data/article
// Construct JSON-LD data for the blog post
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrlString,
  },
  headline: title,
  description: description,
  // /@fs/... paths are Vite dev-server paths and cannot be made into valid public URLs
  image: image?.src && !image.src.startsWith('/@') ? {
    "@type": "ImageObject",
    url: getAbsoluteUrl(image.src),
    width: image.width,
    height: image.height,
    caption: frontmatter.imageAlt,
  } : undefined,
  author: {
    "@type": "Person",
    name: "David Gardiner",
    url: Astro.site?.toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "David Gardiner",
    logo: {
      "@type": "ImageObject",
      url: "https://www.gravatar.com/avatar/37edf2567185071646d62ba28b868fab",
    },
  },
  datePublished: frontmatter.date,
  dateModified: frontmatter.modified_time ?? frontmatter.date,
  keywords: frontmatter.tags?.join(", "),
  inLanguage: "en-AU",
};

const postJsonLd = [blogJsonLd, ...(archiveBreadcrumbs ? [archiveBreadcrumbs] : []), ...tagBreadcrumbs];

if (isBelowIndexWordThreshold(wordCount) && isPostFrom2025Onwards(frontmatter.date)) {
  console.warn(
    `[indexing-threshold] ${Astro.url.pathname} has ${wordCount} words (threshold: ${indexWordThreshold}) and may risk not being indexed.`,
  );
}

const noindex = isPostNoindex(frontmatter, wordCount);

---

<BaseLayout 
  pageTitle={title} 
  frontmatter={{
    title,
    ...(description ? { description } : {}),
    ...(image ? { image } : {}),
    ...(frontmatter.imageAlt ? { imageAlt: frontmatter.imageAlt } : {}),
    tags: frontmatter.tags
  }} 
  canonicalUrl={canonicalUrlString}
  pageJsonLd={postJsonLd}
  noindex={noindex}
>
  <slot name="head" slot="head" />
  
  <h1>{frontmatter.title}</h1>

  <p><DateTimeComponent date={frontmatter.date} /></p>

  <p><em>{frontmatter.description}</em></p>

  <div class="tags">
    {
      frontmatter.tags.map((tag: string) => (
        <p class="tag">
          <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
        </p>
      ))
    }
  </div>

  <slot />

  {related && related.length > 0 && (
    <aside class="related-posts" aria-labelledby="related-posts-heading">
      <h2 id="related-posts-heading">Related posts</h2>
      <ul>
        {related.map((post) => (
          <li><a href={encodeURI(`/${post.id}`)}>{post.title}</a></li>
        ))}
      </ul>
    </aside>
  )}

  {(previous || next) && (
    <nav class="post-navigation" aria-label="Previous and next posts">
      {previous && (
        <a class="post-navigation-previous" rel="prev" href={encodeURI(`/${previous.id}`)}>
          <span>Previous post</span>
          {previous.title}
        </a>
      )}
      {next && (
        <a class="post-navigation-next" rel="next" href={encodeURI(`/${next.id}`)}>
          <span>Next post</span>
          {next.title}
        </a>
      )}
    </nav>
  )}

  {shouldRenderDisqus && (
    <Disqus
      embed="https://davidgardiner.disqus.com/embed.js"
      url={canonicalUrlString ?? Astro.url.href}
    />
  )}
</BaseLayout>
