---

import Footer from "../components/Footer.astro";
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import SiteTitle from "../components/SiteTitle.astro";
import { getCanonicalUrl } from "../scripts/canonical";
import { authorName, authorSameAs, getAuthorId, getOrganizationId } from "../scripts/author";

interface Props {
  pageTitle?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    image?: {
      src: string;
      width: number;
      height: number;
    };
    imageAlt?: string;
  };
  canonicalUrl?: string | undefined;
  pageJsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  noindex?: boolean | undefined;
  ogType?: "article" | "website" | undefined;
}

const { pageTitle, frontmatter, canonicalUrl, pageJsonLd, noindex, ogType = "website" } = Astro.props;

// /@fs/... paths are Vite dev-server paths and cannot be made into valid public URLs
const absoluteImageUrl = frontmatter?.image?.src && !frontmatter.image.src.startsWith('/@')
  ? new URL(frontmatter.image.src, Astro.site ?? Astro.url).toString()
  : undefined;
const twitterTitle = pageTitle?.trim() || frontmatter?.title?.trim();
const twitterDescription = frontmatter?.description?.trim();
const twitterCard = absoluteImageUrl
  ? "summary_large_image"
  : twitterTitle || twitterDescription
    ? "summary"
    : undefined;

// Site-wide JSON-LD structured data
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": getOrganizationId(Astro.site),
      name: authorName,
      url: Astro.site,
      logo: "https://www.gravatar.com/avatar/37edf2567185071646d62ba28b868fab",
      founder: { "@id": getAuthorId(Astro.site) },
      sameAs: authorSameAs,
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site,
      name: "Dave's Daydreams",
      description: `Blog by ${authorName}`,
      publisher: { "@id": getOrganizationId(Astro.site) },
      author: { "@id": getAuthorId(Astro.site) },
    },
  ],
};

const getJsonLdNodes = (
  input: Record<string, unknown> | Array<Record<string, unknown>> | undefined,
): Array<Record<string, unknown>> => {
  if (!input) {
    return [];
  }

  const values = Array.isArray(input) ? input : [input];
  return values.flatMap((value) => {
    const graphValue = value["@graph"];
    if (Array.isArray(graphValue)) {
      return graphValue.filter((node): node is Record<string, unknown> => typeof node === "object" && node !== null);
    }
    return [value];
  });
};

const pageJsonLdNodes = getJsonLdNodes(pageJsonLd).map((node) => {
  const { "@context": _context, ...rest } = node;
  return rest;
});

const mergedJsonLd = {
  "@context": "https://schema.org",
  "@graph": [...siteJsonLd["@graph"], ...pageJsonLdNodes],
};
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={getCanonicalUrl(Astro.url, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <slot name="head" />
    <title>{pageTitle || frontmatter?.title}</title>
    {
      frontmatter?.description && (
        <meta name="description" content={frontmatter.description} />
      )
    }
    {
      frontmatter?.description && (
        <meta property="og:description" content={frontmatter.description} />
      )
    }
    {
      pageTitle && (
        <meta property="og:title" content={pageTitle} />
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dave's Daydreams" />
    <meta property="og:url" content={canonicalUrl ?? getCanonicalUrl(Astro.url, Astro.site)?.toString()} />
    {
      absoluteImageUrl && (
        <meta property="og:image" content={absoluteImageUrl} />
      )
    }
    {
      frontmatter?.image?.width && (
        <meta property="og:image:width" content={frontmatter.image.width.toString()} />
      )
    }
    {
      frontmatter?.image?.height && (
        <meta property="og:image:height" content={frontmatter.image.height.toString()} />
      )
    }
    {
      frontmatter?.imageAlt && (
        <meta property="og:image:alt" content={frontmatter.imageAlt} />
      )
    }
    {twitterCard && <meta name="twitter:card" content={twitterCard} />}
    {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
    {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
    {absoluteImageUrl && <meta name="twitter:image" content={absoluteImageUrl} />}
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      is:raw
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "a5756d0460ba41beba515f2b7666093d"}'
    ></script><!-- End Cloudflare Web Analytics -->

    <!-- Google tag (gtag.js) -->
    {
      Astro.site && Astro.site.href.includes('david.gardiner.net.au') && (
        <>
          <script is:raw is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RKLVTK1HGL"></script>
          <script is:raw is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-RKLVTK1HGL');
          </script>
        </>
      )
    }

    <script
      is:raw
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(mergedJsonLd, null, 2)}
    />
  </head>
  <body>
    <header>
      <nav>
        <Navigation>
          <slot name="site-title" slot="site-title">
            <SiteTitle />
          </slot>
        </Navigation>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
